# server 本地开发环境变量（复制为 .env 使用）
# 宿主机连 docker 里的 mysql 走 3316（compose 已把容器 3306 映射到宿主 3316，避开 nestjs-demo）
DATABASE_URL="mysql://agentflow:agentflow@localhost:3316/agentflow"
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="1d"
PORT=3000
# Redis：审批超时延迟队列(BullMQ) + dashboard 缓存 + notification 重试队列
REDIS_URL="redis://localhost:6379"
