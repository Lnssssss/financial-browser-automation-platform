# server 本地开发环境变量（复制为 .env 使用）
# 宿主机连 docker 里的 mysql 走 3316（compose 已把容器 3306 映射到宿主 3316，避开 nestjs-demo）
DATABASE_URL="mysql://agentflow:agentflow@localhost:3316/agentflow"
PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="1d"
PORT=3000
# Redis：审批超时延迟队列(BullMQ) + dashboard 缓存 + notification 重试队列 + executor-queue
REDIS_URL="redis://localhost:6379"
# Skyvern 核心（Python 浏览器执行层，原样保留）的地址与 API key，webeye 桥接用
# 未配置时 action_handler 调用会 fail-fast 报错（不静默降级）
SKYVERN_BASE_URL="http://localhost:8000/api/v1"
SKYVERN_API_KEY=""
# 演示数据：=1 时 app 启动灌 250 任务/审批/审计/1200 model calls（dashboard 内存 + approval/audit 落库）
# test/prod 置空以免污染。
DEMO_SEED="1"
