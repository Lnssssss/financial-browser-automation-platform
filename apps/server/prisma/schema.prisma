// AgentFlow Studio — Prisma schema
// 设计说明见 harness/notes/architecture/three-dim-rbac.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── 枚举 ───────────────────────────

/// 部门内角色。
enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  OPERATOR
  APPROVER
  VIEWER
}

/// 跨部门特殊权限类型。
enum SpecialPermissionType {
  CROSS_ORG_READ
  CROSS_ORG_APPROVE
}

/// 审批请求生命周期状态。
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  TIMEOUT
}

// ─────────────────────── 多租户根：组织 ───────────────────────
// 三维 RBAC 挂在组织下：跨 org 直接 NONE、所有唯一约束都以 org 为前缀。

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments      Department[]
  businessLines    BusinessLine[]
  users            User[]
  specialPermissions SpecialPermission[]

  @@map("organizations")
}

// ───────────────────── 维度一：部门（层级树）─────────────────────
// parent_id 自引用做任意深度组织树；(org, code) 唯一。

model Department {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?  // NULL = 顶级部门（如“总行”）
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime? // 软删

  organization Organization @relation(fields: [organizationId], references: [id])
  // 自引用：一棵部门树。relation 名 "DeptHierarchy" 区分 parent/children 两端。
  parent       Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DeptHierarchy")
  userRoles    UserDepartmentRole[]

  @@unique([organizationId, code], name: "uq_org_dept_code")
  @@index([organizationId])
  @@map("departments")
}

// ─────────────────── 维度二：业务线（与部门正交）───────────────────
// 和 departments 完全平行、互不引用；(org, code) 唯一。

model BusinessLine {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userLinks    UserBusinessLine[]

  @@unique([organizationId, code], name: "uq_org_line_code")
  @@index([organizationId])
  @@map("business_lines")
}

// ─────────────────────────── 用户 ───────────────────────────
// 本项目整体即企业版，User 直接承载企业用户语义，
// 表名映射 enterprise_users
// 角色是按部门的（见 UserDepartmentRole）。(org, username) 唯一。

model User {
  id             String   @id @default(cuid())
  organizationId String
  username       String
  passwordHash   String
  displayName    String
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id])
  departmentRoles    UserDepartmentRole[]
  businessLines      UserBusinessLine[]
  specialPermissions SpecialPermission[]

  @@unique([organizationId, username], name: "uq_org_username")
  @@index([organizationId])
  @@map("enterprise_users")
}

// ───────────── 维度三：部门角色（三元关联 + 复合主键）★ ─────────────
// 主键 (userId, departmentId)，role 是普通列——
// 这让“一人在不同部门可有不同角色”，同时“一人一部门只有一行”。
// operator/approver 互斥（跨行约束）由应用层事务 + 触发器保证，见 ADR-002。

model UserDepartmentRole {
  userId       String
  departmentId String
  role         Role
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, departmentId]) // 复合主键：三维落地的关键
  @@map("user_department_roles")
}

// ───────────── 用户 × 业务线（纯多对多，不带角色）─────────────
// 业务线只回答“我参与什么”，不回答“我能做什么”，
// 所以这张表没有 role 列。复合主键 (userId, businessLineId)。

model UserBusinessLine {
  userId         String
  businessLineId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  businessLine BusinessLine @relation(fields: [businessLineId], references: [id])

  @@id([userId, businessLineId])
  @@map("user_business_lines")
}

// ─────────────────── 跨部门特殊权限（例外授权）───────────────────
// 跨部门只读/审批不塞进角色体系，用独立 grant 表，
// 有 grantedBy 可审计。(userId, permissionType) 唯一：同一特权只授一次。

model SpecialPermission {
  id             String                @id @default(cuid())
  userId         String
  organizationId String
  permissionType SpecialPermissionType
  grantedBy      String?
  createdAt      DateTime              @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, permissionType], name: "uq_user_permission_type")
  @@index([userId])
  @@map("special_permissions")
}


// ─────────────────── 高危操作分级审批 ───────────────────
// 风险识别引擎命中高危操作时生成，
// 记录从"创建 → 决策/超时"的完整生命周期。设计见 ADR-004 与 approval-flow 笔记。

model ApprovalRecord {
  id             String   @id @default(cuid())
  taskId         String   // 触发审批的任务 ID
  organizationId String
  departmentId   String   // 来源部门
  businessLineId String?

  // 风险识别详情（可追溯）
  riskLevel            String // low/medium/high/critical
  riskReason           String @db.Text
  operationDescription String? @db.Text
  screenshotKey        String? // MinIO key（只存 key 不存二进制）

  // 审批路由
  approverDepartmentId String
  approverRole         String   @default("approver")
  notifyDepartmentIds  Json     @default("[]")

  // 生命周期
  status        ApprovalStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  approverUserId String?
  decidedAt     DateTime?
  decisionNote  String?        @db.Text
  // 超时时长按风险等级绑定：high 3600s / critical 1800s（越紧急越短）。见 DEFAULT_TIMEOUTS。
  timeoutSeconds Int           @default(3600)

  // 最高频查询：某机构/某部门下所有 pending 记录 → 两个复合索引。
  @@index([organizationId, status], name: "idx_apr_org_status")
  @@index([approverDepartmentId, status], name: "idx_apr_dept_status")
  @@index([taskId])
  @@map("approval_requests")
}
