// AgentFlow Studio — Prisma schema
// 设计说明见 harness/notes/architecture/three-dim-rbac.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── 枚举 ───────────────────────────

/// 部门内角色。
enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  OPERATOR
  APPROVER
  VIEWER
}

/// 跨部门特殊权限类型。
enum SpecialPermissionType {
  CROSS_ORG_READ
  CROSS_ORG_APPROVE
}

/// 审批请求生命周期状态。
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  TIMEOUT
}

// ─────────────────────── 多租户根：组织 ───────────────────────
// 三维 RBAC 挂在组织下：跨 org 直接 NONE、所有唯一约束都以 org 为前缀。

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments      Department[]
  businessLines    BusinessLine[]
  users            User[]
  specialPermissions SpecialPermission[]

  @@map("organizations")
}

// ───────────────────── 维度一：部门（层级树）─────────────────────
// parent_id 自引用做任意深度组织树；(org, code) 唯一。

model Department {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?  // NULL = 顶级部门（如“总行”）
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime? // 软删

  organization Organization @relation(fields: [organizationId], references: [id])
  // 自引用：一棵部门树。relation 名 "DeptHierarchy" 区分 parent/children 两端。
  parent       Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DeptHierarchy")
  userRoles    UserDepartmentRole[]

  @@unique([organizationId, code], name: "uq_org_dept_code")
  @@index([organizationId])
  @@map("departments")
}

// ─────────────────── 维度二：业务线（与部门正交）───────────────────
// 和 departments 完全平行、互不引用；(org, code) 唯一。

model BusinessLine {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userLinks    UserBusinessLine[]

  @@unique([organizationId, code], name: "uq_org_line_code")
  @@index([organizationId])
  @@map("business_lines")
}

// ─────────────────────────── 用户 ───────────────────────────
// 本项目整体即企业版，User 直接承载企业用户语义，
// 表名映射 enterprise_users
// 角色是按部门的（见 UserDepartmentRole）。(org, username) 唯一。

model User {
  id             String   @id @default(cuid())
  organizationId String
  username       String
  passwordHash   String
  displayName    String
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id])
  departmentRoles    UserDepartmentRole[]
  businessLines      UserBusinessLine[]
  specialPermissions SpecialPermission[]

  @@unique([organizationId, username], name: "uq_org_username")
  @@index([organizationId])
  @@map("enterprise_users")
}

// ───────────── 维度三：部门角色（三元关联 + 复合主键）★ ─────────────
// 主键 (userId, departmentId)，role 是普通列——
// 这让“一人在不同部门可有不同角色”，同时“一人一部门只有一行”。
// operator/approver 互斥（跨行约束）由应用层事务 + 触发器保证，见 ADR-002。

model UserDepartmentRole {
  userId       String
  departmentId String
  role         Role
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, departmentId]) // 复合主键：三维落地的关键
  @@map("user_department_roles")
}

// ───────────── 用户 × 业务线（纯多对多，不带角色）─────────────
// 业务线只回答“我参与什么”，不回答“我能做什么”，
// 所以这张表没有 role 列。复合主键 (userId, businessLineId)。

model UserBusinessLine {
  userId         String
  businessLineId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  businessLine BusinessLine @relation(fields: [businessLineId], references: [id])

  @@id([userId, businessLineId])
  @@map("user_business_lines")
}

// ─────────────────── 跨部门特殊权限（例外授权）───────────────────
// 跨部门只读/审批不塞进角色体系，用独立 grant 表，
// 有 grantedBy 可审计。(userId, permissionType) 唯一：同一特权只授一次。

model SpecialPermission {
  id             String                @id @default(cuid())
  userId         String
  organizationId String
  permissionType SpecialPermissionType
  grantedBy      String?
  createdAt      DateTime              @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, permissionType], name: "uq_user_permission_type")
  @@index([userId])
  @@map("special_permissions")
}


// ─────────────────── 高危操作分级审批 ───────────────────
// 风险识别引擎命中高危操作时生成，
// 记录从"创建 → 决策/超时"的完整生命周期。设计见 ADR-004 与 approval-flow 笔记。

model ApprovalRecord {
  id             String   @id @default(cuid())
  taskId         String   // 触发审批的任务 ID
  organizationId String
  departmentId   String   // 来源部门
  businessLineId String?

  // 风险识别详情（可追溯）
  riskLevel            String // low/medium/high/critical
  riskReason           String @db.Text
  operationDescription String? @db.Text
  screenshotKey        String? // MinIO key（只存 key 不存二进制）

  // 审批路由
  approverDepartmentId String
  approverRole         String   @default("approver")
  notifyDepartmentIds  Json     @default("[]")

  // 生命周期
  status        ApprovalStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  approverUserId String?
  decidedAt     DateTime?
  decisionNote  String?        @db.Text
  // 超时时长按风险等级绑定：high 3600s / critical 1800s（越紧急越短）。见 DEFAULT_TIMEOUTS。
  timeoutSeconds Int           @default(3600)

  // 最高频查询：某机构/某部门下所有 pending 记录 → 两个复合索引。
  @@index([organizationId, status], name: "idx_apr_org_status")
  @@index([approverDepartmentId, status], name: "idx_apr_dept_status")
  @@index([taskId])
  @@map("approval_requests")
}

// ─────────────────── 全链路审计日志 ───────────────────
// 每个动作步骤一条记录：脱敏后的输入 + 原值 SHA-256（可验篡改而不存明文）+
// 前后截图 key（只存 MinIO/S3 对象 key，不存二进制）+ 执行耗时 + 审批关联，供合规审查。
// 三维（org/dept/businessLine）裸存字符串（对齐 ApprovalRecord：审计是写多读少的旁路，
// 不建外键 relation 以免拖慢主执行流的写入）。

model AuditLog {
  id             String   @id @default(cuid())
  taskId         String
  organizationId String
  departmentId   String
  businessLineId String?

  // 动作详情
  actionIndex     Int
  actionType      String
  targetElement   String? @db.Text
  inputValue      String? @db.Text // 已脱敏
  inputValueRawHash String? // 原值 SHA-256，验完整性用（不存明文）
  pageUrl         String? @db.Text

  // 截图（MinIO/S3 对象 key）
  screenshotBeforeKey String?
  screenshotAfterKey  String?

  // 执行
  durationMs      Int?
  executor        String  // "agent" 或 user_id
  executionResult String  @default("success")
  errorMessage    String? @db.Text

  // 审批关联
  hasApproval    Boolean @default(false)
  approvalId     String?
  approverUserId String?

  createdAt DateTime @default(now())

  // 三个最高频查询维度 → 三复合索引：按任务追时间线 / 按机构查时段 / 按部门查时段。
  @@index([taskId, actionIndex], name: "idx_aud_task_action")
  @@index([organizationId, createdAt], name: "idx_aud_org_time")
  @@index([departmentId, createdAt], name: "idx_aud_dept_time")
  @@map("audit_logs")
}

// ─────────────── 任务的企业元数据扩展（租户隔离对象）───────────────
// Skyvern 任务本体在执行层（Python Worker），这里只挂三维归属 + 风险等级，
// 供多维租户隔离过滤：查询按 (org, 可见部门 OR 可见业务线) 收敛可见范围。
// 三维裸存字符串 + 各自索引（对齐 ApprovalRecord/AuditLog：不建 relation，
// 让企业元数据与执行层任务解耦，隔离过滤只吃这三列 + org）。

model TaskExtension {
  id             String   @id @default(cuid())
  taskId         String   @unique // 一个任务一条扩展
  organizationId String
  departmentId   String
  businessLineId String? // 可空：任务可能不归属任何业务线
  riskLevel      String   @default("low")
  createdBy      String // 创建者 user_id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 隔离过滤的三个维度各建索引：org 恒过滤，dept/bl 受限用户按可见集合 IN。
  @@index([organizationId], name: "idx_ext_org")
  @@index([departmentId], name: "idx_ext_dept")
  @@index([businessLineId], name: "idx_ext_bl")
  @@map("task_extensions")
}
